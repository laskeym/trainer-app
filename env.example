# Copy this file to .env and fill in your actual Supabase project values.
# Never commit .env — it's gitignored.

# Found in your Supabase project dashboard: Project Settings > API
EXPO_PUBLIC_SUPABASE_ANON_KEY_LOCAL=
EXPO_PUBLIC_SUPABASE_URL_REMOTE=
EXPO_PUBLIC_SUPABASE_ANON_KEY_REMOTE=
EXPO_PUBLIC_USE_LOCAL_SUPABASE=true

# PowerSync instance URL (PowerSync Dashboard > Connect). Not a secret, but
# it only works against the REMOTE Supabase project the instance replicates
# from, so set EXPO_PUBLIC_USE_LOCAL_SUPABASE=false when using it.
# Leave empty to run without sync.
EXPO_PUBLIC_POWERSYNC_URL=
